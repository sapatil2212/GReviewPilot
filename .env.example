# =========================================================
# GReviewPilot - Environment template
# =========================================================
# Copy to .env and fill in real values. This file is committed to git,
# so it must never contain a real credential.

NODE_ENV="production"

APP_URL="https://app.example.com"

# Port this Node process binds. APP_UPSTREAM defaults to 127.0.0.1:$PORT, so
# setting PORT alone keeps nginx and the app in agreement.
PORT="3000"

# Address nginx proxies tenant custom domains to. Leave unset unless you have a
# reason: it defaults to 127.0.0.1:$PORT. Must NOT be 80/443 (those are nginx's
# own ports — a proxy loop), and must be the port THIS app listens on. On a
# server hosting several apps, naming another app's port makes nginx serve that
# application's website to your customers' domains, and `npm run doctor` fails.
# APP_UPSTREAM="127.0.0.1:3000"

SITE_APEX_IP="203.0.113.10"

SITE_CNAME_TARGET="app.example.com"

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# openssl rand -base64 32
AUTH_SECRET="<32+ byte base64 secret>"
AUTH_URL="https://app.example.com"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------
# Token encryption
# ---------------------------------------------------------
# openssl rand -hex 32
# Encrypts stored Google OAuth tokens. REQUIRED in production when Google
# OAuth is enabled: without it the key is derived from AUTH_SECRET, so
# rotating AUTH_SECRET would make every stored Google token permanently
# unreadable and force all tenants to reconnect. Never rotate this without
# a re-consent plan.
ENCRYPTION_KEY="<32 byte hex secret>"

# ---------------------------------------------------------
# Google Business Profile OAuth
# ---------------------------------------------------------
# Prerequisites in Google Cloud, in order — see docs/GOOGLE-BUSINESS-SETUP.md:
#   1. Request Business Profile API access and wait for approval. An API
#      quota limit of 0 means the request has NOT been approved yet.
#   2. Enable the Business Profile API family on the project.
#   3. Configure the OAuth consent screen with the business.manage scope.
#   4. Publish the app and complete verification. While it is in "Testing",
#      only listed test users can connect — everyone else gets
#      "Error 403: access_denied".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Must match an Authorized redirect URI on the OAuth client byte for byte.
# Required explicitly in production; must be https and end with
# /api/google/callback.
GOOGLE_REDIRECT_URI="https://app.example.com/api/google/callback"

# business.manage is mandatory — every Business Profile call depends on it.
GOOGLE_BUSINESS_SCOPES="openid email profile https://www.googleapis.com/auth/business.manage"

# Places API key, used by Quick Connect and Places review sync. Restrict it
# to the Places API and to this server's IP.
GOOGLE_MAPS_API_KEY=""

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM="GReviewPilot <no-reply@example.com>"
EMAIL_BCC=""

STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="/var/www/storage/greviewpilot"
WEBSITE_MEDIA_PATH="/var/www/storage/greviewpilot/website"

SSL_PROVISIONING="nginx"
# auto | directive | listen | off. "auto" detects the installed nginx: the
# standalone `http2 on;` directive only exists from nginx 1.25.1, and emitting it
# on an older build (Ubuntu 24.04 ships 1.24.0) fails nginx -t so no HTTPS vhost
# loads at all. Leave on auto unless you need to force a form.
NGINX_HTTP2="auto"
# "staging" for the first run only. Staging certificates issue successfully but no
# browser trusts them, so leaving this set produces working-looking logs and a
# security warning for every visitor. Switch to "production" once one domain has
# been issued end to end.
ACME_DIRECTORY="production"
ACME_CONTACT_EMAIL="ops@example.com"
ACME_ACCOUNT_KEY_PATH="/var/www/storage/greviewpilot/acme/account.key"
SSL_CERT_PATH="/var/www/storage/greviewpilot/certs"
NGINX_VHOST_PATH="/etc/nginx/greviewpilot-sites"
NGINX_RELOAD_COMMAND="sudo /usr/local/bin/greviewpilot-nginx-reload"
SSL_CA_ISSUER_DOMAIN="letsencrypt.org"

# ---------------------------------------------------------
# Super admin
# ---------------------------------------------------------
# The code defaults for these are weak placeholders. Always set them.
SUPER_ADMIN_USER=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_SECRET=""

# ---------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------
# openssl rand -hex 32
# Presented as `Authorization: Bearer <secret>`. Without it the /api/cron/*
# endpoints return 503 and queued sync jobs are never processed.
CRON_SECRET=""
AUTO_SYNC_INTERVAL_MINUTES="720"

# Google GBP app-level quotas (keep well below Google's hard limits)
GOOGLE_ACCOUNT_API_QPM="60"
GOOGLE_BUSINESS_API_QPM="120"
GOOGLE_REVIEW_API_QPM="60"
GOOGLE_PERFORMANCE_API_QPM="30"
GOOGLE_MAX_CONCURRENT_REQUESTS="4"
GOOGLE_RETRY_LIMIT="5"
GOOGLE_BACKOFF_BASE_MS="2000"
GOOGLE_BACKOFF_MAX_MS="300000"
GOOGLE_SYNC_WORKER_BATCH="5"
GOOGLE_SYNC_LOCK_TTL_SEC="300"

# Telemetry retention, pruned on the auto-sync tick.
GOOGLE_REQUEST_LOG_RETENTION_DAYS="14"
GOOGLE_SYNC_RUN_RETENTION_DAYS="90"

TZ="Asia/Kolkata"
