# =========================================================
# GReviewPilot — Environment Variables (template)
# Copy to .env and fill in real values.
# =========================================================

# ---------- App ----------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ---------- Database (MySQL) ----------
# URL-encode special chars in the password (@ = %40, : = %3A, etc.)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"

# ---------- Auth.js ----------
# Generate: openssl rand -base64 32   (or) node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------- Google OAuth (optional in dev) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional — defaults to ${APP_URL}/api/google/callback if left blank.
GOOGLE_REDIRECT_URI=""
# Optional — override default scope list.
GOOGLE_BUSINESS_SCOPES="openid email profile https://www.googleapis.com/auth/business.manage"

# ---------- Encryption ----------
# Optional. When blank we derive a 256-bit key from AUTH_SECRET via HKDF.
# Set to a 64-char hex string, 32-byte base64, or 32+ char passphrase to override.
ENCRYPTION_KEY=""

# ---------- Google Places API (optional) ----------
# Enables auto-fetch of business name/address/rating from a Place ID in
# the Quick Connect flow. Enable "Places API" in Google Cloud, create an
# API key, and restrict it to the Places API.
GOOGLE_MAPS_API_KEY=""

# ---------- AI (Gemini) ----------
# Powers AI review generation, AI post/reply drafting, sentiment analysis,
# and review insights. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Prefer the floating "-latest" alias. Pinned versions get retired by
# Google and then return 404, which silently degrades every AI feature to
# its non-AI fallback. Verify a model with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-latest"

# ---------- Scheduled jobs (auto-sync) ----------
# Leave blank to keep /api/cron/* disabled (returns 503).
# Set a long random secret to enable, then have your scheduler call:
#   curl -H "Authorization: Bearer $CRON_SECRET" $APP_URL/api/cron/auto-sync
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
# Skip accounts synced more recently than this many minutes (default 720 = 12h).
AUTO_SYNC_INTERVAL_MINUTES="720"
# Certificate monitoring for custom domains. Re-checks the live certificate on
# every connected domain, advancing SSL status and flagging expiring or broken
# certificates. Without it, SSL state is only ever observed when a user presses
# Verify. Hourly is recommended:
#   curl -H "Authorization: Bearer $CRON_SECRET" $APP_URL/api/cron/ssl-monitor

# ---------- Storage ----------
# Local-disk provider (default). Where MediaAsset files are written.
# Relative paths resolve against the project root; absolute paths (e.g. a
# VPS mount) are used as-is.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH=".uploads"
# Dedicated root for website-builder image uploads (MediaCategory.WEBSITE_MEDIA
# — hero images, gallery slides, backgrounds set from the editor). Kept
# separate from STORAGE_LOCAL_PATH so site assets can be backed up/served
# independently of the rest of the tenant's media library.
# Example VPS layout: WEBSITE_MEDIA_PATH="/var/www/storage/greviewpilot/website"
WEBSITE_MEDIA_PATH="website"

# ---------- Website builder — platform subdomain (optional) ----------
# Every website gets a free address at <slug>.SITES_ROOT_DOMAIN, the same idea
# as Lovable/Vercel/Bolt preview URLs. Requires a wildcard DNS record
# (*.sites.yourdomain.com -> your app) and a wildcard TLS certificate for that
# subdomain. Leave blank to only offer /s/<slug> on APP_URL.
SITES_ROOT_DOMAIN=""
# A-record IP tenants point custom apex domains (e.g. clinic.com) at.
# On a self-hosted VPS this is the server's public IP. The Vercel default below
# WILL send your tenants' domains to Vercel — change it.
SITE_APEX_IP="76.76.21.21"
# CNAME target tenants point subdomains (e.g. www.clinic.com) at.
# Must be a bare hostname: no scheme, no port, no trailing dot. Leave blank to
# fall back to APP_URL's hostname — correct only while that name resolves to the
# server tenant traffic must reach, and it yields "localhost" in development.
# Set it explicitly in production so tenant DNS survives the dashboard moving.
SITE_CNAME_TARGET=""
# The CA that issues certificates for custom domains, spelled as it appears in a
# CAA DNS record. Used to warn a tenant when their CAA records would block
# issuance — a common cause of a domain that verifies but never gets HTTPS.
#   Vercel / certbot / Caddy -> letsencrypt.org
#   Cloudflare               -> pki.goog  (or digicert.com, depending on plan)
SSL_CA_ISSUER_DOMAIN="letsencrypt.org"

# ---------- Certificate provisioning (self-hosted nginx only) ----------
# Full setup guide: docs/CUSTOM-DOMAINS-VPS.md
#
# "off"   — something else terminates TLS (Vercel, Cloudflare, Caddy). The app
#           only observes certificates and never tries to issue them.
# "nginx" — the app issues certificates via ACME and writes one nginx server
#           block per custom domain, then reloads nginx.
SSL_PROVISIONING="off"
# Staging issues real but untrusted certificates. Keep it here until a domain has
# been provisioned end to end: Let's Encrypt production allows ~5 certificates
# per domain per week, and exhausting that locks the domain out of HTTPS for days.
ACME_DIRECTORY="staging"
# Registered with the CA; receives expiry warnings if our renewals ever stop.
ACME_CONTACT_EMAIL=""
# Persisted so we reuse one CA registration instead of creating a new account on
# every deploy. Created automatically on first use.
ACME_ACCOUNT_KEY_PATH="/var/www/storage/greviewpilot/acme/account.key"
# Issued certificates, one directory per hostname. nginx must be able to read it.
SSL_CERT_PATH="/var/www/storage/greviewpilot/certs"
# Directory nginx includes server blocks from.
NGINX_VHOST_PATH="/etc/nginx/sites-enabled"
# Must run without a password prompt, and must validate before reloading.
# See docs/CUSTOM-DOMAINS-VPS.md for the script and the sudoers entry.
NGINX_RELOAD_COMMAND="sudo /usr/local/bin/greviewpilot-nginx-reload"
# Address nginx proxies tenant traffic to — where the Node process actually
# listens. This is NOT derivable from APP_URL: behind nginx, APP_URL is nginx
# itself, so inferring it produced `proxy_pass http://127.0.0.1:443` and a proxy
# loop. Must not be port 80 or 443; env validation rejects those.
APP_UPSTREAM="127.0.0.1:3000"

# ---------- Email (SMTP via nodemailer) ----------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM="GReviewPilot <no-reply@yourdomain.com>"
EMAIL_BCC=""
