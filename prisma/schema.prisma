// GReviewPilot — Authentication + Workspace schema
// See /src/server/db/prisma.ts for the singleton client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum UserRole {
  SUPER_ADMIN
  TENANT_OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
  DELETED
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
  DELETED
}

enum TenantPlan {
  TRIAL
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

// Billing lifecycle. Kept independent from TenantStatus so a workspace
// can be ACTIVE while its billing is PAST_DUE (grace window), etc.
enum BillingStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

