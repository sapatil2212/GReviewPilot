  GOOGLE_ACCOUNT_DISCONNECTED
  GOOGLE_TOKEN_REFRESHED
  GOOGLE_SYNC_STARTED
  GOOGLE_SYNC_COMPLETED
  GOOGLE_SYNC_FAILED
  GOOGLE_LOCATION_LINKED
  GOOGLE_LOCATION_UNLINKED
